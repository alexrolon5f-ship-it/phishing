DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=phishing_estudio

# Completar en .env con los datos de la cuenta remitente.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Se completan con npm.cmd run setup-admin.
ADMIN_USER=admin
ADMIN_SALT=
ADMIN_HASH=
# Opcional: en Render se configura en Environment; dejalo vacío para XAMPP.
DATABASE_URL=
# email para la versión local; database para guardar en PostgreSQL/MariaDB.
PARTICIPATION_MODE=email
# Solo en Render, detrás de su proxy HTTPS: 1
TRUST_PROXY=0
# Destinatario local opcional. Si está vacío, se usa SMTP_USER.
SMTP_TO=
